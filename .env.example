# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me
POSTGRES_DB=budgetapp
DATABASE_URL=postgresql://budget:change-me@localhost:5432/budgetapp

# Random 32+ char string used to sign sessions
SESSION_SECRET=change-me

# Optional: LLM fallback for categorization (leave empty to disable)
ANTHROPIC_API_KEY=
